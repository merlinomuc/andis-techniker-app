{
  "name": "andis-techniker-app",
  "version": "3.3.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <23",
    "npm": ">=9"
  },
  "scripts": {
    "install:server": "npm install --prefix server --omit=dev",
    "install:client": "npm install --prefix client --include=dev",
    "install:all": "npm run install:server && npm run install:client",
    "build:client": "npm run build --prefix client",
    "build": "npm run install:all && npm run build:client",
    "start": "npm start --prefix server",
    "test": "npm test --prefix server",
    "verify": "node --check server/index.js && node --test server/tests/*.test.js"
  }
}
